<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="province" model="ir.ui.view">
            <field name="name">province.form</field>
            <field name="model">province</field>
            <field name="arch" type="xml">
                <form string="Province">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Province Name..."/></h1>
                        </div>
                        <group>
                            <field name="district_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="is_active"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="province_list" model="ir.ui.view">
            <field name="name">province.list</field>
            <field name="model">province</field>
            <field name="arch" type="xml">
                <list string="Provinces" default_order="name">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="action_province" model="ir.actions.act_window">
            <field name="name">Provinces</field>
            <field name="res_model">province</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_province"
                  name="Provinces"
                  parent="menu_equipment_config"
                  action="action_province"
                  sequence="1"/>
    </data>
</odoo>
