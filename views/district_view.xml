<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="district" model="ir.ui.view">
            <field name="name">district.form</field>
            <field name="model">district</field>
            <field name="arch" type="xml">
                <form string="District">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="District Name..."/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="province_id"/>
                                <field name="is_active"/>
                            </group>
                        </group>
                        <group string="Wards">
                            <field name="ward_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="district_list" model="ir.ui.view">
            <field name="name">district.list</field>
            <field name="model">district</field>
            <field name="arch" type="xml">
                <list string="Districts" default_order="name">
                    <field name="name"/>
                    <field name="province_id"/>
                    <field name="is_active"/>
                </list>
            </field>
        </record>

        <record id="action_district" model="ir.actions.act_window">
            <field name="name">Districts</field>
            <field name="res_model">district</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_district"
                  name="Districts"
                  parent="menu_equipment_config"
                  action="action_district"
                  sequence="2"/>
    </data>
</odoo>
