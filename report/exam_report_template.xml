<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- REPORT TEMPLATE -->
    <template id="exam_report_template">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">

                <t t-call="web.external_layout">

                    <div class="page">

                        <div style="text-align:center">
                            <h2>Báo Cáo</h2>
                        </div>

                        <p>
                            Student:
                            <span t-field="doc.student_name"/>
                        </p>

                        <p>
                            Exam Date:
                            <span t-field="doc.exam_date"/>
                        </p>

                        <p>
                            Score:
                            <span t-field="doc.score"/>
                        </p>

                        <!-- TABLE SUBJECT -->
                        <table class="table table-sm table-bordered" style="margin-top:20px;">

                            <thead>
                                <tr>
                                    <th style="padding:8px;">Subject</th>
                                    <th style="padding:8px;">Score</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td style="padding:8px;">
                                            <span t-field="line.subject"/>
                                        </td>
                                        <td style="padding:8px;">
                                            <span t-field="line.score"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>

                        </table>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>