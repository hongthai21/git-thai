<odoo>
    <data>
        <record id="view_import_excel_wizard_form" model="ir.ui.view">
            <field name="name">import.excel.wizard.form</field>
            <field name="model">import.excel.wizard</field>
            <field name="arch" type="xml">
                <form string="Import Excel">
                    <!-- Lưu exam_id ẩn -->
                    <field name="exam_id" invisible="1"/>

                    <!-- FILE -->
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>

                    <!-- PREVIEW -->
                    <group string="Preview Data">
                        <button name="action_load_file"
                                string="Load File"
                                type="object"
                                class="btn-secondary"/>
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="score"/>
                                <field name="error" decoration-danger="error"/>
                            </list>
                        </field>
                    </group>

                    <!-- FOOTER -->
                    <footer>
                        <button name="action_import"
                                type="object"
                                string="Import"
                                class="btn-primary"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>