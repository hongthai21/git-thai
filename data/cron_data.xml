<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <data>
        <!-- Cron: Remind overdue pending requests (> 3 days) -->
        <record id="cron_remind_overdue_requests" model="ir.cron">
            <field name="name">Equipment: Remind Pending Requests (> 3 days)</field>
            <field name="model_id" ref="model_equipment_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_overdue_requests()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Cron: Check for past-deadline requests -->
        <record id="cron_check_deadline" model="ir.cron">
            <field name="name">Equipment: Check Past Deadline Requests</field>
            <field name="model_id" ref="model_equipment_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_deadline()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
